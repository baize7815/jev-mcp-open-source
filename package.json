{
  "name": "jev-mcp-worker",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted Jev MCP on Cloudflare Workers with intent routing, retrieval reranking and batch judgments",
  "author": "baize7815",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "privacy:check": "node scripts/check-privacy.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "predeploy": "node scripts/check-config.mjs",
    "deploy": "wrangler deploy --strict --keep-vars"
  },
  "dependencies": { "@modelcontextprotocol/server": "2.0.0", "agents": "0.24.0", "zod": "4.6.5" },
  "devDependencies": { "@types/node": "26.6.2", "typescript": "7.0.2", "wrangler": "4.136.0" }
}
